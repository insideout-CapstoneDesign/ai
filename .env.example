# ===== 애플리케이션 =====
# 실행 환경 (local / dev / prod)
ENVIRONMENT=local
# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ===== 서버 =====
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# ===== 백엔드 연동 =====
BACKEND_URL=http://localhost:8080

# ===== S3 / MinIO (실제 AI 구현 시 필요) =====
# 실제 키/시크릿은 .env에만 입력 (커밋 금지)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=insideout-floorplan
# MinIO 사용 시 http://localhost:9000, AWS면 비워두기
S3_ENDPOINT=
S3_REGION=ap-northeast-2

# ===== AI 모델 =====
# OCR 인식 언어 (ko/en)
OCR_LANGUAGE=ko
# 예: /app/models/yolov8n.pt
YOLO_MODEL_PATH=
