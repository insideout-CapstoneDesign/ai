# ======================================================================
# .env.example
# 
# 사용법:
#   cp .env.example .env
#   그다음 .env 파일을 열어 실제 값으로 수정
# ======================================================================

# ===== 애플리케이션 =====
ENVIRONMENT=local                          # local / dev / prod
LOG_LEVEL=INFO                             # DEBUG / INFO / WARNING / ERROR

# ===== 서버 =====
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# ===== 백엔드 연동 =====
BACKEND_URL=http://localhost:8080

# ===== S3 / MinIO (실제 AI 구현 시 필요) =====
S3_ENDPOINT=                               # MinIO 사용 시 http://localhost:9000, AWS면 비워두기
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=                             # 실제 키 (커밋 X)
S3_SECRET_KEY=                             # 실제 시크릿 (커밋 X)
S3_BUCKET=indoor-nav-floorplans

# ===== AI 모델 =====
YOLO_MODEL_PATH=                           # 예: /app/models/yolov8n.pt
OCR_LANGUAGE=ko