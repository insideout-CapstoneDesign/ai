# ===== 애플리케이션 =====
# 실행 환경 (local / dev / prod)
ENVIRONMENT=local
# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ===== 서버 =====
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# ===== 백엔드 연동 =====
BACKEND_URL=http://localhost:8080

# ===== S3 / MinIO (실제 AI 구현 시 필요) =====
# 실제 키/시크릿은 .env에만 입력 (커밋 금지)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=insideout-floorplan
# MinIO 사용 시 http://localhost:9000, AWS면 비워두기
S3_ENDPOINT=
S3_REGION=ap-northeast-2

# ===== AI 모델 =====
# OCR 인식 언어 (ko/en)
OCR_LANGUAGE=ko
# OCR engine (paddleocr / easyocr)
OCR_ENGINE=paddleocr
# PaddleOCR oneDNN acceleration. Keep false on Windows CPU environments.
PADDLEOCR_ENABLE_MKLDNN=false
# EasyOCR GPU 사용 여부 (로컬 CPU 환경은 false)
OCR_GPU=false
# EasyOCR 모델 저장 경로 (비워두면 기본 경로 사용)
OCR_MODEL_STORAGE_DIR=
# EasyOCR 모델 자동 다운로드 허용 여부
OCR_DOWNLOAD_ENABLED=true
# OCR 결과 최소 신뢰도 (0.0~1.0)
OCR_CONFIDENCE_THRESHOLD=0.0
# POI 아이콘 템플릿 이미지 디렉터리
ICON_TEMPLATE_DIR=app/assets/icon_templates
# POI 아이콘 템플릿 매칭 최소 유사도 (0.0~1.0)
ICON_TEMPLATE_MATCH_THRESHOLD=0.75
# POI 아이콘 템플릿 중복 제거 IoU 기준 (0.0~1.0)
ICON_TEMPLATE_NMS_THRESHOLD=0.3
